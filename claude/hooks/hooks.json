{
  "description": "cave-tools auto-init: SessionStart skill injection, SubagentStart injection, per-turn reinforcement, PreToolUse redirect, MCP failure/denial recovery, statusline refresh.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cave-tools-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading cave-tools rules..."
          },
          {
            "type": "command",
            "command": "cave-tools status --emit-statusline",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cave-tools-subagent.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cave-tools-mode-tracker.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|WebFetch|WebSearch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/cave-tools-redirect.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__cave-tools__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cave-tools status --emit-statusline",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__cave-tools__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cave-tools-recover.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "mcp__cave-tools__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cave-tools-recover.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
