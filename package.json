{
  "name": "@groobybugs/cave-tools",
  "version": "0.4.3",
  "description": "A caveman needs their tools. Token-optimized MCP server providing drop-in replacements for any agent.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cave-tools": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "claude/",
    "rules/",
    "src/plugins/",
    "scripts/*.mjs",
    "install.sh",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "tsc --noEmit",
    "test": "pnpm run build && node test.mjs",
    "start": "node dist/cli.js",
    "mcp": "node dist/cli.js mcp",
    "install:agents": "node scripts/install-agent-instructions.mjs",
    "remove:agents": "node scripts/remove-agent-instructions.mjs",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "agent",
    "compression",
    "tokens",
    "caveman",
    "cli"
  ],
  "author": {
    "name": "groobybugs",
    "email": "groobybugs299@hotmail.com",
    "url": "https://github.com/groobybugs"
  },
  "license": "MIT",
  "homepage": "https://github.com/groobybugs/cave-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/groobybugs/cave-tools.git"
  },
  "bugs": {
    "url": "https://github.com/groobybugs/cave-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
